# Copy to .env.local (or set in Plesk) and fill in. NEXT_PUBLIC_* values are baked in at build time,
# so rebuild after changing them. Leave a value empty to keep that feature off.

NEXT_PUBLIC_SITE_URL=https://buildervault.camwow.tv

# Analytics: pick one. Plausible is cookie-free; GA4 sets cookies.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (content="..." value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
