# Copy to .env.local (or set in Plesk) and fill in. NEXT_PUBLIC_* values are baked in at build time,
# so rebuild after changing them. Leave a value empty to keep that feature off.

NEXT_PUBLIC_SITE_URL=https://buildervault.camwow.tv

# Analytics: pick one. Plausible is cookie-free; Google Tag Manager and GA4 set cookies.
# With Tag Manager, add the GA4 tag inside the container and leave NEXT_PUBLIC_GA_MEASUREMENT_ID empty.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (content="..." value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Newsletter: the form action URL from your email provider's HTML embed form
# (Buttondown, Kit/ConvertKit, MailerLite, Mailchimp...). Signup boxes are hidden until this is set.
NEXT_PUBLIC_NEWSLETTER_FORM_ACTION=
# Name of the email input your provider expects (default: email; Mailchimp uses EMAIL, Kit uses email_address)
NEXT_PUBLIC_NEWSLETTER_EMAIL_FIELD=

# BuilderVault Pro ($3/month or $30/year through Stripe). Read at request time, so no rebuild is
# needed after changing them; restart the app instead. Pro stays hidden unless PRO_ENABLED=true.
# Never commit real values. Set them in the Plesk Node.js panel. Full steps: docs/pro-setup.md
PRO_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
SESSION_SECRET=
EMAIL_API_KEY=
EMAIL_FROM=
BASE_URL=https://buildervault.camwow.tv
PRO_COMP_EMAILS=
DATA_DIR=
